{
  "name": "sc-next-electron",
  "displayName": "SC - Electron and Next",
  "version": "11.0.2",
  "description": "SC - Electron and Next",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": false,
  "license": "MIT",
  "main": "dist/backend/index.js",
  "author": {
    "name": "Saulo Costa",
    "email": "saulotarsobc@gmail.com",
    "url": "https://github.com/saulotarsobc"
  },
  "scripts": {
    "dev": "npm run build:backend && electron . --dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p backend --noEmit",
    "clear": "rimraf out && rimraf dist",
    "build:frontend": "next build src",
    "build:backend": "tsc -p backend",
    "build": "npm run build:frontend && npm run build:backend",
    "postinstall": "electron-builder install-app-deps",
    "update:readme": "tsx scripts/update-readme.ts",
    "dist:clear": "npm run clear && npm run build && electron-builder",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "sc-prepare-next": "^1.1.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.4": true,
    "sqlite3@6.0.1": true,
    "unrs-resolver@1.12.2": true
  },
  "build": {
    "appId": "br.com.electron.next",
    "productName": "SC - Electron and Next",
    "asar": true,
    "files": [
      "dist"
    ],
    "directories": {
      "output": "out"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${name}-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "signIgnore": null,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${name}-${version}-linux-${arch}.${ext}"
    }
  }
}
